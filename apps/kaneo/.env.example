# Copy to .env and fill in. Never commit .env — it is gitignored.

# Database credentials for the bundled postgres container.
POSTGRES_USER=kaneo
POSTGRES_DB=kaneo
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Signs session cookies. Rotating it logs everyone out.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of this instance. Must match how you actually reach it, including
# the scheme, or OAuth/redirect flows and CSRF origin checks will reject it.
KANEO_CLIENT_URL=https://kaneo.localhost