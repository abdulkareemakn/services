# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Authentication policy is set in compose.yaml (unauthenticated access allowed,
# registration closed). This file is for the remaining options.
#
# Signing key for issued tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Two-factor authentication for logins.
TOTP_ISSUER=convertx
TOTP_URI=