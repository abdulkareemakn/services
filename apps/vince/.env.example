# Copy to .env and fill in. Never commit .env — it is gitignored.

# Credentials for the first admin account, used only when the database is
# created. Changing them later has no effect — use the admin UI instead.
VINCE_ADMIN_NAME=
VINCE_ADMIN_PASSWORD=

# Comma-separated list of sites this instance tracks. Each needs a DNS or
# Caddy entry pointing at this instance, and the tracking snippet from the
# admin UI embedded on the site.
#
# For a site served by the Caddy ingress in this repo, add a block to
# infra/caddy/Caddyfile and use that hostname here, e.g. myapp.localhost
VINCE_DOMAINS=