# Copy to .env and fill in. Never commit .env — it is gitignored.

# The full set of linkding options is documented upstream:
#   https://github.com/sissbruecker/linkding/blob/master/docs/Options.md
# Only the settings that matter for a single-user instance are listed here.
# Anything omitted falls back to linkding's own default.

# ─── Behaviour ───────────────────────────────────────────────────────────────
LD_CONTEXT_PATH=
LD_DISABLE_BACKGROUND_TASKS=false
LD_DISABLE_URL_VALIDATION=false

# ─── Authentication ──────────────────────────────────────────────────────────
# Leave the superuser fields empty when relying on an authenticating proxy.
# Caddy in this repo does not authenticate, so either set these or leave every
# service un-authenticated on purpose.
LD_SUPERUSER_NAME=
LD_SUPERUSER_PASSWORD=

# ─── Origins ─────────────────────────────────────────────────────────────────
# Must list the URL you actually use, or form submissions fail CSRF checks.
LD_CSRF_TRUSTED_ORIGINS=https://bookmarks.localhost

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite by default; uncomment to use postgres instead. Note the compose file
# ships no postgres service, so you would need to add one.
LD_DB_ENGINE=sqlite
LD_DB_DATABASE=
LD_DB_USER=
LD_DB_PASSWORD=
LD_DB_HOST=
LD_DB_PORT=