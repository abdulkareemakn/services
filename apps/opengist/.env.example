# Copy to .env and fill in. Never commit .env — it is gitignored.

# ─── First-run admin account ────────────────────────────────────────────────
# Created only when the database is initialised. Changing these later has no
# effect — use the web UI instead.
OPENGIST_ADMIN_USERNAME=
OPENGIST_ADMIN_PASSWORD=

# ─── Server ──────────────────────────────────────────────────────────────────
# Public URL of this instance. Must match how you actually reach it or
# clone/push URLs and OAuth callbacks will be wrong.
OPENGIST_SERVER_URL=https://opengist.localhost

# Set to true only if you serve opengist under a path prefix.
OPENGIST_SUB_PATH=

# Disable registration after creating the first account.
OPENGIST_DISABLE_REGISTRATION=true