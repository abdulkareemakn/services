# Copy to .env and fill in. Never commit .env — it is gitignored.

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=sure
POSTGRES_DB=sure_production
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Signs Rails cookies and encrypted credentials. Rotating it invalidates
# existing sessions.
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# ─── Optional: OpenAI ─────────────────────────────────────────────────────────
# Leaving these empty disables AI features. Enabling them incurs cost on every
# AI call (chat, rules) — set a spend limit on the account first.
OPENAI_ACCESS_TOKEN=
OPENAI_MODEL=
OPENAI_URI_BASE=
LLM_CONTEXT_WINDOW=
OPENAI_REQUEST_TIMEOUT=60

# ─── Backups ─────────────────────────────────────────────────────────────────
# Read by your backup tooling rather than the compose file.
BACKUP_SCHEDULE=
BACKUP_KEEP_DAYS=
BACKUP_KEEP_WEEKS=
BACKUP_KEEP_MONTHS=