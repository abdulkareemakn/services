# Copy to .env and fill in. Never commit .env — it is gitignored.

# Skip the single-user gate and sign in with Google. Leave the ID empty to
# disable Google login entirely.
BL_SINGLE_USER_MODE=true
SINGLE_USER_MODE=true
BL_GOOGLE_ID=

# The web tier reaches the API over the proxy network using the value hardcoded
# in compose.yaml (http://booklogr-api:5000). If you need the browser to reach
# the API too, it is published separately at https://booklogr-api.localhost.