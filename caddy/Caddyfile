solar.abdulkareem.codes {
    reverse_proxy homeassistant:8123 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Port {server_port}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        format console
        output file /logs/homeassistant.log {
            roll_size     10mb
            roll_keep     20
            roll_keep_for 7d
        }
    }

    encode zstd gzip
}

tinyauth.abdulkareem.codes {
    @allowed {
        remote_ip 139.135.38.238
    }
    handle @allowed {
        reverse_proxy tinyauth:3000
    }
    handle {
        respond "Access Denied" 403
    }
}


