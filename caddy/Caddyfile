(tinyauth) {
    forward_auth tinyauth:3000 {
       uri /api/auth/caddy 
       copy_headers Remote-User Remote-Name Remote-Email Remote-Groups
    }
}


actual.abdulkareem.codes {
    reverse_proxy actualbudget:5006

    encode zstd gzip
}

bookmarks.abdulkareem.codes {
    reverse_proxy linkding:9090

    log {
	format console
        output file /logs/linkding.log {
            roll_size     10mb
            roll_keep     20
            roll_keep_for 7d
        }
    }

    encode zstd gzip
}

