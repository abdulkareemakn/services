# Copy to .env and fill in. Never commit .env — it is gitignored.

# ─── Beszel hub authentication ───────────────────────────────────────────────
# The hub must know the agent's credentials. Create the agent in the hub UI
# first, then paste the values it gives you here.
BEZEL_TOKEN=
BEZEL_KEY=

# Set false (the default) so the hub requires a password. Only set true if you
# have another layer of authentication in front of it.
DISABLE_PASSWORD_AUTH=false