# Copy to .env and fill in. Never commit .env — it is gitignored.

# Cloudflare R2 credentials used by litestream.yml. R2 is S3-compatible, so
# these use the standard AWS variable names litestream expects.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Referenced from litestream.yml so the bucket and endpoint are not committed.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com