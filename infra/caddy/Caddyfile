# Local homelab ingress.
#
# This file is the single source of truth for how services are reached.
# Backends resolve by container_name over the shared `proxy` network, so no
# application publishes a host port and port conflicts cannot happen.
#
# TLS uses Caddy's internal CA. Trust it once per device with `make trust`,
# then every *.localhost URL below is a valid browser URL.
{
	admin localhost:2019
	local_certs

	servers {
		trusted_proxies static private_ranges
	}

	log {
		output file /data/logs/access.log {
			roll_size 20mb
			roll_keep 10
			roll_keep_for 168h
		}
	}
}

# Applied to every application below.
(common) {
	import security
	reverse_proxy {args[0]}
}

(security) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer-when-downgrade"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
	encode zstd gzip
}

