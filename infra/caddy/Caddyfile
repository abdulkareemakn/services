# ─── Catch-all ───────────────────────────────────────────────────────────────
# Unknown *.localhost names get a useful answer instead of a TLS error.

:80 {
	redir https://{host}{uri} permanent
}

*.localhost:443 {
	respond "No route for {host}. Add a block to infra/caddy/Caddyfile." 404
}
